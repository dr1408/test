# made by https://github.com/dr1408

echo "=== $(date) Mounting all filesystems ==="

mkdir -p /mnt1 /mnt2 /mnt6 /mnt7 /mnt8
APFS_UTIL=/System/Library/Filesystems/apfs.fs/apfs.util

volume_for_role() {
    wanted=$1
    for device in /dev/disk1s[1-9] /dev/disk0s1s[1-9]; do
        [ -e "$device" ] || continue
        role=$("$APFS_UTIL" -p "$device" 2>/dev/null || true)
        [ "$role" = "$wanted" ] && {
            printf '%s\n' "$device"
            return 0
        }
    done
    return 1
}

mount_role() {
    role=$1
    target=$2
    device=$(volume_for_role "$role") || {
        echo "ERROR: missing APFS $role volume"
        return 1
    }
    echo "  mounting $role ($device) at $target"
    /sbin/mount_apfs "$device" "$target" 2>/dev/null
    if [ $? -eq 0 ]; then
        echo "  OK $role mounted"
    else
        echo "  WARN $role mount may already be done"
    fi
}

# Mount System, Preboot, xART
echo "Mounting base volumes..."
mount_role System /mnt1
mount_role Preboot /mnt6 || true
mount_role xART /mnt7 || true

# Load SEP and mount Data
echo ""
echo "Loading SEP and mounting Data..."

if ! mount | grep -q "/mnt6"; then
    echo "ERROR: Preboot (/mnt6) is not mounted"
    exit 1
fi

SEP_PATH=$(find /mnt6 -name "sep-firmware.img4" 2>/dev/null | head -1)
if [ -z "$SEP_PATH" ]; then
    echo "ERROR: SEP firmware not found in /mnt6"
    exit 1
fi
echo "  Found SEP firmware: $SEP_PATH"

echo "  Initializing SEP..."
/usr/libexec/seputil --gigalocker-init 2>/dev/null
if [ $? -eq 0 ]; then
    echo "  OK SEP initialized"
else
    echo "  WARN SEP may already be initialized"
fi

echo "  Setting NVRAM..."
/usr/sbin/nvram oblit-inprogress=1 rev=2 2>/dev/null
if [ $? -eq 0 ]; then
    echo "  OK NVRAM set"
else
    echo "  WARN NVRAM set failed"
fi

echo "  Loading SEP firmware..."
/usr/libexec/seputil --load "$SEP_PATH" 2>/dev/null
if [ $? -eq 0 ]; then
    echo "  OK SEP loaded"
else
    echo "  WARN SEP load may have failed"
fi

echo "  Clearing NVRAM..."
/usr/sbin/nvram -d oblit-inprogress 2>/dev/null

if /usr/sbin/nvram oblit-inprogress 2>/dev/null | grep -q "oblit-inprogress"; then
    echo "  WARN NVRAM still has oblit-inprogress, trying again..."
    /usr/sbin/nvram -d oblit-inprogress 2>/dev/null
    if /usr/sbin/nvram oblit-inprogress 2>/dev/null | grep -q "oblit-inprogress"; then
        echo "  FAIL NVRAM could not be cleared"
    else
        echo "  OK NVRAM cleared on second attempt"
    fi
else
    echo "  OK NVRAM cleared"
fi

# Mount Data dynamically
echo "  Mounting Data..."
mount_role Data /mnt2

# Wait 5 seconds for mount to settle
echo "  Waiting 5 seconds for mount to settle..."
sleep 5

if mount | grep -q "/mnt2"; then
    echo "  OK Data mounted at /mnt2"
else
    echo "  FAIL Data mount failed"
    exit 1
fi

# Mount User volume (/mnt8) - AFTER Data is mounted
echo ""
echo "Mounting User volume..."
mount_role User /mnt8 || true

echo ""
echo "=== Mount verification ==="
mount | grep -E "/mnt[0-9]"